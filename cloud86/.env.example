APP_ENV=production
APP_URL=https://gls.beteccontrols.nl
APP_TIMEZONE=Europe/Amsterdam
# Een willekeurige geheime waarde van 64 hextekens. Niet hergebruiken voor andere systemen.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gls_exact
DB_USERNAME=gls_exact
DB_PASSWORD=

# Begin altijd in mock. Zet dit pas na acceptatietests op test of production.
GLS_MODE=mock
# Officiële GLS-testendpoints. Vervang deze pas na acceptatie door de productie-endpoints.
GLS_VALIDATE_LOGIN_URL=https://api.gls.nl/test/v1/api/Authentication/ValidateLogin?api-version=1.0
GLS_CREATE_LABEL_URL=https://api.gls.nl/test/v1/api/Label/Create?api-version=1.0
GLS_CONFIRM_LABEL_URL=https://api.gls.nl/test/v1/api/Label/Confirm?api-version=1.0
GLS_API_KEY=
GLS_API_KEY_HEADER=Ocp-Apim-Subscription-Key
GLS_USERNAME=
GLS_PASSWORD=
# Gebruik afzonderlijke klantnummers voor Parcel en Freight.
GLS_PARCEL_CUSTOMER_NO=
GLS_FREIGHT_CUSTOMER_NO=
# Alleen voor achterwaartse compatibiliteit; wordt gebruikt als het typespecifieke nummer leeg is.
GLS_CUSTOMER_NO=
GLS_LABEL_TYPE=pdfa6s
# false: alleen label maken; units moeten later met ConfirmLabel worden bevestigd.
# true: verzenddatum meesturen, waardoor GLS de zending direct vrijgeeft.
GLS_SEND_SHIPPING_DATE=false
GLS_WEBHOOK_BEARER_TOKEN=

EXACT_BASE_URL=https://start.exactonline.nl
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REDIRECT_URI=https://gls.beteccontrols.nl/oauth/exact/callback
EXACT_DIVISION=
EXACT_WEBHOOK_SECRET=
EXACT_SYNC_LIMIT=50

