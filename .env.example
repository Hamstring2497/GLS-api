APP_DATABASE_PATH=gls_exact.sqlite3
GLS_MODE=mock

# De exacte URL en subscription-key komen uit het afgeschermde GLS developerportal.
# Officiële GLS testendpoints (portal, oktober 2026).
GLS_CREATE_LABEL_URL=https://api.gls.nl/test/v1/api/Label/Create
GLS_CONFIRM_LABEL_URL=https://api.gls.nl/test/v1/api/Label/Confirm
# Het portal toont voor T&T een HTTP-test-URL. Laat deze leeg tot GLS een HTTPS-URL bevestigt.
GLS_TRACK_DETAILS_URL=
GLS_API_KEY=
GLS_API_KEY_HEADER=Ocp-Apim-Subscription-Key
GLS_USERNAME=
GLS_PASSWORD=
GLS_CUSTOMER_NO=
GLS_LABEL_TYPE=pdf

GLS_TRACK_USERNAME=
GLS_TRACK_PASSWORD=

